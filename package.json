{
  "name": "injeca-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest --coverage",
    "test:run": "vitest run",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck": "tsc --noEmit && pnpm -F @injeca/docs typecheck",
    "up": "taze -w -r -I -f && pnpm prune && pnpm dedupe",
    "docs:sync-readme": "node scripts/sync-readme.ts",
    "docs:toc": "doctoc --github --title \"## Table of Contents\" --maxlevel=3 README.md",
    "docs:update": "pnpm docs:toc && pnpm docs:sync-readme"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@moeru/eslint-config": "^0.1.0-beta.20",
    "@moeru/std": "^0.1.0-beta.20",
    "@moeru/tsconfig": "^0.1.0-beta.20",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "doctoc": "^2.5.0",
    "eslint": "^10.15.0",
    "eslint-plugin-oxlint": "^1.93.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "taze": "^21.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "unplugin-yaml": "^4.3.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
